rules_version = '2';

// Raíces Storage security rules.
//
// Layout:
//   users/{uid}/profile/avatar.jpg               profile photo, private
//   users/{uid}/plants/{plantId}/{photoId}.jpg   user uploads, private
//   species/{speciesId}/{imageId}.jpg            editorial media, read-only
//
// User uploads are writable only by their owner, only as images, and only up
// to 10 MB. Editorial species media is published through the Admin SDK; no
// client path grants write access to it.

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isImage() {
      return request.resource.contentType != null
          && request.resource.contentType.matches('image/.*');
    }

    function withinSizeLimit() {
      return request.resource.size <= 10 * 1024 * 1024;
    }

    match /users/{userId}/plants/{plantId}/{fileName} {
      allow read, delete: if isOwner(userId);
      allow write: if isOwner(userId) && isImage() && withinSizeLimit();
    }

    // One profile photo, replaced in place. Owner only, same image limits.
    match /users/{userId}/profile/{fileName} {
      allow read, delete: if isOwner(userId);
      allow write: if isOwner(userId)
                   && fileName == 'avatar.jpg'
                   && isImage()
                   && withinSizeLimit();
    }

    // Readable without sign-in so the species browser can render alongside the
    // publicly readable Firestore catalog.
    match /species/{speciesId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Anything not matched above stays closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
